{
	"version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake -S . -B build",
      "problemMatcher": []
    },  
    {
      "label": "configure for win",
      "type": "shell",
      "command": "cmake -S . -B build -G 'MinGW Makefiles'",
      "problemMatcher": []
    },       
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build -j20",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "cmake --build build --target clean",
      "problemMatcher": [],
    },
    {
      "label": "down-can",
      "type": "shell",
      "windows":{
        "command": "tools/win/fw-loader.exe -b 600 -p com40 -i 1 -f build/stm32g4-fdcan-fw.bin",
      },
      
      "problemMatcher": [],
    }, 
  ]
}